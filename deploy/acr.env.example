ACR_REGISTRY=op-registry.cloudcc.cn
ACR_IMAGE_PREFIX=op-registry.cloudcc.cn/cloudcc-ai-native
CICI_IMAGE_TAG=latest
CICI_APP_VERSION=latest
CICI_PLATFORM=linux/amd64

# Optional: set these before running scripts/deploy-acr.sh if the host is not
# already logged in with docker login.
ACR_USERNAME=
ACR_PASSWORD=

POSTGRES_DB=agentcici
POSTGRES_USER=cici
POSTGRES_PASSWORD=cici123
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=cici
RABBITMQ_DEFAULT_PASS=cici123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

QDRANT_PORT=6333

BACKEND_PORT=8080
FRONTEND_PORT=80
HTTPS_PORT=443
SSL_ENABLED=false

SPRING_PROFILES_ACTIVE=local
APP_AUTH_JWT_SECRET=change-me-in-prod-change-me-in-prod-2026
APP_SECRET_KEY=
APP_SECURITY_SECRET_KEY=
APP_AUTH_BOOTSTRAP_ADMIN_MOBILES=13800138111,13900009999
APP_AUTH_PLATFORM_ADMIN_MOBILES=13800138111
APP_AUTH_PLATFORM_OPERATOR_MOBILES=
APP_AUTH_PLATFORM_SUPPORT_MOBILES=
APP_AUTH_PLATFORM_BILLING_MOBILES=
APP_AUTH_PLATFORM_AUDITOR_MOBILES=

# Comma-separated browser origins allowed to call /openapi/v1/** directly.
# Prefer server-to-server Open API calls when the API key must stay secret.
APP_AGENT_OPEN_API_ENABLED=true
APP_AGENT_OPEN_API_CONVERSATION_API_ENABLED=true
APP_AGENT_OPEN_API_KEY_PEPPER=
APP_AGENT_OPEN_API_CORS_ALLOWED_ORIGINS=*

APP_KB_QDRANT_COLLECTION=cici_kb_chunk
APP_KB_STORAGE_DIR=/app/data/kb-files

# Configure this before using AI model calls.
APP_MODEL_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_MODEL_ALIYUN_API_KEY=
APP_MODEL_ALIYUN_DEFAULT_MODEL=qwen3.5-flash
# Directional HMAC secrets for the mandatory AgentCiCi <-> Semattice provisioning handshake.
# Keep values only in the production secret file; never commit real keys.
# APP_NATIVE_AGENTCICI_INTERNAL_HMAC_KEY is also AI_NATIVE_AGENTCICI_HMAC_KEY in Semattice.
# APP_SEMATTICE_INTERNAL_HMAC_KEY is the `agentcici=` entry in AI_NATIVE_PROVISIONING_CALLER_KEYS.
APP_NATIVE_AGENTCICI_INTERNAL_HMAC_KEY=
APP_SEMATTICE_BASE_URL=https://semattice.agentcici.com
APP_SEMATTICE_INTERNAL_HMAC_KEY=
# Product-manager SERVICE reviews use this governed DEV Autopilot endpoint.
APP_DEV_AUTOPILOT_BASE_URL=https://x.agentcici.com/devautopilot

CICI_TOOL_TAVILY_API_BASE=https://api.tavily.com
