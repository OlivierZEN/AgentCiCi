FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /src
COPY backend backend
RUN mvn -q -f backend/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre-noble

ARG CICI_APP_VERSION=dev
ARG CICI_GIT_COMMIT=unknown

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/backend/target/cc-cici-assistant-backend-*.jar /app/app.jar
COPY deploy/docker-entrypoint.secrets.sh /usr/local/bin/cici-entrypoint
RUN chmod 0755 /usr/local/bin/cici-entrypoint

ENV CICI_APP_VERSION=${CICI_APP_VERSION}
ENV GIT_COMMIT=${CICI_GIT_COMMIT}

LABEL org.opencontainers.image.title="AgentCiCi Backend"
LABEL org.opencontainers.image.version="${CICI_APP_VERSION}"
LABEL org.opencontainers.image.revision="${CICI_GIT_COMMIT}"

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/cici-entrypoint"]
CMD ["java", "-jar", "/app/app.jar"]
